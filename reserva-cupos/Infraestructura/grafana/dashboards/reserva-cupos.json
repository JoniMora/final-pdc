{
  "uid": "reserva-cupos-e6",
  "title": "Reserva de cupos — Entrega 6",
  "tags": [
    "entrega-6",
    "reserva-cupos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Instancias con métricas disponibles",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"api|worker|relay|notificador\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Reservas admitidas por segundo — HTTP 202",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pdc_http_solicitudes_total{servicio=\"api\",metodo=\"POST\",ruta=~\".*/reservas\",estado=\"202\"}[1m]))",
          "legendFormat": "Admisiones/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "p95 de admisión de reservas — HTTP 202",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pdc_http_duracion_segundos_bucket{servicio=\"api\",metodo=\"POST\",ruta=~\".*/reservas\",estado=\"202\"}[1m])))",
          "legendFormat": "p95 admisión"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Decisiones de reserva por segundo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resultado) (rate(pdc_eventos_total{servicio=\"worker\",tipo=\"reservar\",resultado=~\"confirmada|rechazada|fallida\"}[1m]))",
          "legendFormat": "{{resultado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Webhooks: entregas, errores y reintentos por segundo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resultado) (rate(pdc_eventos_total{servicio=\"notificador\",tipo=\"webhook\"}[1m]))",
          "legendFormat": "{{resultado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "p95 de duración del intento HTTP de webhook",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pdc_http_duracion_segundos_bucket{servicio=\"notificador\",ruta=\"webhook\"}[1m])))",
          "legendFormat": "p95 intento HTTP"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "RabbitMQ: mensajes por cola",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rabbitmq_queue_messages)",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Traefik: respuestas por segundo y código HTTP",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{entrypoint=\"websecure\"}[1m]))",
          "legendFormat": "HTTP {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Por tenant: solicitudes por segundo y código HTTP",
      "description": "Solicitudes autenticadas en la API, por tenant (su nombre) y código. Un 429 aparece solo en el tenant que agotó su límite.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant, estado) (rate(pdc_tenant_solicitudes_total[1m]))",
          "legendFormat": "{{tenant}} · {{estado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Por tenant: webhooks por segundo y resultado",
      "description": "Entregas del notificador por tenant. Si el receptor de uno se cae, sus webhooks quedan diferidos (circuito abierto) y los demás siguen entregados.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant, resultado) (rate(pdc_webhook_tenant_total[1m]))",
          "legendFormat": "{{tenant}} · {{resultado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Circuito por tenant: 0 cerrado, 1 abierto, 2 semiabierto",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pdc_webhook_circuito_estado",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Caché de autenticación: proporción de aciertos",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pdc_eventos_total{tipo=\"auth_cache\",resultado=\"hit\"}[1m])) / clamp_min(sum(rate(pdc_eventos_total{tipo=\"auth_cache\"}[1m])), 0.001)",
          "legendFormat": "Aciertos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Consultas de autenticación a MySQL por segundo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pdc_eventos_total{tipo=\"auth_mysql\",resultado=\"consulta\"}[1m]))",
          "legendFormat": "Consultas/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "p95 de demora total de webhook",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(pdc_webhook_demora_segundos_bucket[1m])))",
          "legendFormat": "p95 entrega"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Límite global: solicitudes aceptadas y rechazadas",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 61
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(resultado)(rate(pdc_eventos_total{tipo=\"limite_distribuido\"}[1m]))",
          "legendFormat": "{{resultado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Admisión por lotes: admisiones por commit y commits por segundo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 69
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pdc_admision_lote_tamano_sum[1m])) / clamp_min(sum(rate(pdc_admision_lote_tamano_count[1m])), 0.001)",
          "legendFormat": "admisiones por commit"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pdc_admision_lote_tamano_count[1m]))",
          "legendFormat": "commits de admisión por segundo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
